# 虚拟环境与缓存
.venv/
.uv-cache/
__pycache__/
*.py[cod]

# IDE
.idea/

# 竞赛题目材料（如需入库请手动 git add -f resources/Problem/）
resources/Problem/

# 机器狗运行日志（接口层自动记录，不入库）
logs/*.jsonl

# 验证脚本 F 组的暂存目录（正常跑完会自删，异常中断时兜底）
.tmp_verify/

# 模拟器运行痕迹（每次演练自动重建，非源码/交付物）
resources/jammers-py/data/behavior-logs/
resources/jammers-py/data/practice-statistics-queue.sqlite3

# 本地演练场（复刻模拟器，仅用于 --practice 时自动拉起；上游产物，非本仓库代码）
# 交付与复现都不需要它：官方模式连真机，--plan-only 连不到模拟器也能跑
resources/jammers-py/

# 参考文献 PDF（53 M，撰写论文时本地查阅用；体积不适合入库）
# README 与 reports/ 里引用的结论都写了出处，不依赖这些 PDF 文件本身
resources/References/

# LaTeX 编译中间产物（交付物是 .tex 源码与编译好的 main.pdf）
*.aux
*.toc
*.out
*.synctex.gz
