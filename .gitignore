# 虚拟环境与缓存
.venv/
.uv-cache/
__pycache__/
*.py[cod]

# IDE
.idea/

# 竞赛题目材料（如需入库请手动 git add -f Problem/）
Problem/

# 机器狗运行日志（接口层自动记录，不入库）
logs/*.jsonl

# 验证脚本 F 组的暂存目录（正常跑完会自删，异常中断时兜底）
.tmp_verify/

# 模拟器运行痕迹（每次演练自动重建，非源码/交付物）
jammers-py/data/behavior-logs/
jammers-py/data/practice-statistics-queue.sqlite3
