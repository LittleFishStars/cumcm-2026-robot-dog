# 虚拟环境与 Python 缓存
.venv/
.uv-cache/
__pycache__/
*.py[cod]

# 编辑器与系统
.idea/
Thumbs.db
desktop.ini

# 本机材料：一律不入库（确实要入库时用 git add -f）
#   Problem/      赛题材料
#   References/   参考文献 PDF（53 M，撰写论文时本地查阅用）
#   latex/        论文源文件
# resources/latex 要放行，得先把目录本身反忽略：光在文件末尾写 !resources/latex/*.tex 没用，
# git 不会进入被忽略的目录，那条规则永远匹配不上
resources/*
!resources/latex/
resources/latex/*

# 本地演练场 jammers-py/ 是独立子仓库（git submodule，私有远端），已移到仓库根，
# 只登记其提交指针；它内部的 data/、figures/ 由子仓库自己的 .gitignore 排除

# 求解产物：不入库（随跑随新；同 seed 逐字节可复现，唯一例外是 api_calls.jsonl 的现实时间戳）
results/

# 交付包 export/：从工作区整理出来的那份支撑材料，随时可重建，不入库
export/

# 正式测评的官方行为日志：封装头里写着参赛队号，不入库，也不进支撑材料包
official-logs/

# LaTeX 编译中间产物（交付物是 .tex 源码与编译好的 PDF）
*.aux
*.log
*.toc
*.out
*.synctex.gz
*.fls
*.fdb_latexmk
*.bbl
*.blg
*.nav
*.snm
*.vrb
*.bcf
*.run.xml

# 论文正文：本机写作中，不入库
*.tex
!resources/latex/*.tex
